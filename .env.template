# .env.template - copia este archivo a .env y añade tu PRODUCT_ID y opcionalmente
# una URL de validación si quieres validar licencias en tu servidor.

# El Product ID de Gumroad (recomendado) — si usas Gumroad para emitir license keys
GUMROAD_PRODUCT_ID=TU_PRODUCT_ID_DE_GUMROAD

# Opcional: URL del servicio de validación de licencias (POST {"license_key":"..."})
# Si está vacía, el CLI usará la verificación directa con la API pública de Gumroad.
LICENSE_VALIDATION_URL=

# Tiempo de espera para peticiones a la API (segundos)
API_TIMEOUT=10

# API key que protege el servicio de validación (si se establece, las peticiones
# a /verify deben incluir el header X-API-KEY=<KEY>)
LICENSE_SERVER_API_KEY=
